# Cabeceras para Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/)

# Los archivos de Vite llevan hash en el nombre: se pueden cachear para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fuentes propias: cambian poco, sin hash en el nombre.
/fonts/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
